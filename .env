# Этот файл хранится в Git и содержит безопасные настройки приложения.
# Реальные секреты и OAuth-параметры добавляйте только в игнорируемый .env.local.
# Настройки Docker находятся в .env.docker, а тестовые переопределения — в .env.test.

### Приложение ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=local-demo-secret-not-for-production
APP_TIMEZONE=Europe/Moscow

### Адрес сайта ###
SITE_BASE_SCHEME=http
SITE_BASE_HOST=localhost:${APP_PORT}
ADMIN_EMAIL=admin@example.test
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

### Инфраструктурные подключения ###
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?serverVersion=18&charset=utf8"
MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=doctrine://default

### OAuth ###
# 0 полностью запрещает login, registration и linking через provider.
# Реальные credentials хранятся только в игнорируемом .env.local.
OAUTH_GOOGLE_ENABLED=0
OAUTH_YANDEX_ENABLED=0
OAUTH_VK_ENABLED=0
OAUTH_GITHUB_EN_ENABLED=0
OAUTH_GITHUB_RUS_ENABLED=0
OAUTH_FACEBOOK_ENABLED=0
OAUTH_LINKEDIN_ENABLED=0
OAUTH_MAILRU_ENABLED=0

OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=
OAUTH_VK_CLIENT_ID=
OAUTH_VK_CLIENT_SECRET=
OAUTH_GITHUB_EN_CLIENT_ID=
OAUTH_GITHUB_EN_CLIENT_SECRET=
OAUTH_GITHUB_RUS_CLIENT_ID=
OAUTH_GITHUB_RUS_CLIENT_SECRET=
