{
    "name": "yaleksandr89/symfony-shop",
    "description": "Educational Symfony e-commerce application with Docker, PostgreSQL, API Platform, OAuth and Vue.",
    "homepage": "https://github.com/yaleksandr89/symfony-shop",
    "keywords": [
        "php",
        "symfony",
        "e-commerce",
        "postgresql",
        "docker",
        "api-platform",
        "oauth",
        "vue",
        "educational"
    ],
    "authors": [
        {
            "name": "Александр Юрченко",
            "email": "y.aleksandr89@yandex.ru",
            "homepage": "https://github.com/yaleksandr89",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/yaleksandr89/symfony-shop/issues",
        "source": "https://github.com/yaleksandr89/symfony-shop",
        "forum": "https://github.com/yaleksandr89/symfony-shop/discussions",
        "security": "https://github.com/yaleksandr89/symfony-shop/security/policy"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://boosty.to/backendbezpafosa"
        },
        {
            "type": "other",
            "url": "https://sponsr.ru/backendbezpafosa/"
        }
    ],
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "~8.5.0",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "api-platform/core": "^5.0",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.6",
        "gedmo/doctrine-extensions": "^3.22",
        "imagine/imagine": "^1.0",
        "knplabs/knp-paginator-bundle": "^6.10",
        "knpuniversity/oauth2-client-bundle": "^2.0",
        "league/oauth2-github": "^3.0",
        "league/oauth2-google": "^5.0",
        "spiriitlabs/form-filter-bundle": "^12.1",
        "nelmio/cors-bundle": "^2.0",
        "phpdocumentor/reflection-docblock": "^6.0",
        "stof/doctrine-extensions-bundle": "^1.15",
        "symfony/asset": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/error-handler": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "^2.10",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/notifier": "8.1.*",
        "symfony/process": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/string": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/web-link": "8.1.*",
        "symfony/webpack-encore-bundle": "^2.4",
        "symfony/yaml": "8.1.*",
        "symfonycasts/reset-password-bundle": "^1.0",
        "symfonycasts/verify-email-bundle": "^1.0",
        "twig/cssinliner-extra": "^3.0",
        "twig/extra-bundle": "^3.0",
        "twig/inky-extra": "^3.0",
        "twig/intl-extra": "^3.0",
        "twig/twig": "^3.0",
        "yaleksandr89/oauth2-yandex": "^1.0"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.6",
        "friendsofphp/php-cs-fixer": "^3.95",
        "hautelook/alice-bundle": "^2.17",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.3",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.0",
        "symfony/panther": "^2.0",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "Tools\\Demo\\": "tools/demo/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*"
    },
    "scripts": {
        "lint": [
            "@php -l config/bundles.php config/preload.php public/index.php bin/console .php-cs-fixer.dist.php",
            "find src tests migrations tools/demo fixtures/demo -type f -name \"*.php\" -exec php -l {} +"
        ],
        "analyse": "@php vendor/bin/phpstan analyse --no-progress",
        "cs:check": "@php vendor/bin/php-cs-fixer check --diff",
        "cs:fix": "@php vendor/bin/php-cs-fixer fix",
        "check": [
            "@composer validate --strict --no-check-publish",
            "@composer audit --locked",
            "@lint",
            "@cs:check",
            "@analyse"
        ],
        "test": [
            "@php tests/TestUtils/Database/verify.php",
            "@php vendor/bin/phpunit --group unit --group integration --group functional --do-not-record-test-run-history --no-coverage"
        ],
        "test:unit": "@php vendor/bin/phpunit --group unit --do-not-record-test-run-history --no-coverage",
        "test:integration": [
            "@php tests/TestUtils/Database/verify.php",
            "@php vendor/bin/phpunit --group integration --do-not-record-test-run-history --no-coverage"
        ],
        "test:functional": [
            "@php tests/TestUtils/Database/verify.php",
            "@php vendor/bin/phpunit --group functional --do-not-record-test-run-history --no-coverage"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
