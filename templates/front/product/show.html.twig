{% extends 'front/base.html.twig' %}

{% block title %}{{ product.title }}{% endblock %}
{% block page_description %}{{ product.description|default(product.title) }}{% endblock %}
{% block canonical_link %}<link rel="canonical" href="{{ canonicalLink }}"/>{% endblock %}

{% block body %}

    <div class="page-content mt-3">
        <div class="container">
            <div class="product-full mb-2">
                <div class="row">
                    <div class="col-md-6">
                        <figure class="product-media">
                            {% if product.isNew or product.isOnSale %}
                                <div class="product-merchandising-statuses">
                                    {% if product.isNew %}
                                        <span class="product-sale-status sale-status-new">{{ 'similar_products.new'|trans }}</span>
                                    {% endif %}
                                    {% if product.isOnSale %}
                                        <span class="product-sale-status sale-status-sale">{{ 'similar_products.sale'|trans }}</span>
                                    {% endif %}
                                </div>
                            {% endif %}
                            {% for image in product.getProductImages().getValues() %}
                                <img
                                        src="{{ asset('uploads/images/products/' ~ product.id ~ '/' ~ image.getFilenameBig()) }}" alt="{{ product.title }}"
                                        class="product-image">
                            {% endfor %}
                        </figure>
                    </div>

                    <div class="col-md-6">
                        <div class="product-full-content">
                            <h1 class="product-title title-gradient-1">{{ product.title }}</h1>

                            <div class="product-price">
                                ${{ product.price }}
                            </div>

                            <div class="product-content">
                                <p>{{ product.description }}</p>
                            </div>

                            <div class="product-full-filters">
                                <div class="form-group ml-4">
                                    <label for="product_full_filter_quantity">Qty:</label>
                                    <input
                                            type="number"
                                            id="product_full_filter_quantity"
                                            class="form-control"
                                            value="1"
                                            min="1"
                                            max="{{ product.quantity }}"
                                            step="1"
                                            data-decimals="0"
                                            required
                                    >
                                </div>
                            </div>

                            <div class="product-full-action">
                                <a href="#" class="btn btn-link btn-dark" data-add-cart-product-page>
                                    <i class="fas fa-cart-plus"></i>
                                    <span>{{ 'product.add_to_cart'|trans }}</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    {{ render(controller('App\\Controller\\Front\\EmbedController::showSimilarProducts', {
                        'productCount': 4,
                        'categoryId': product.category.id
                    })) }}
                </div>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    <script>
        const productUuid = '{{ product.uuid }}';
        const productStock = Number({{ product.quantity }});
        const productQuantityEl = document.getElementById('product_full_filter_quantity');
        const productShowAddCart = document.querySelector('[data-add-cart-product-page]');

        productShowAddCart.addEventListener('click', function (event) {
            event.preventDefault();
            const requestedQuantity = Number(productQuantityEl.value);
            if (
                !Number.isInteger(productStock) || productStock < 1 ||
                !Number.isInteger(requestedQuantity) || requestedQuantity < 1
            ) {
                productQuantityEl.value = '1';
                return;
            }

            const quantity = Math.min(requestedQuantity, productStock);
            productQuantityEl.value = quantity.toString();

            window.vueMenuCartInstance.addCartProduct({
                uuid: productUuid,
                quantity: quantity,
                stock: productStock,
            });
        });

        productQuantityEl.addEventListener('focusout', function (event) {
            event.preventDefault();

            const selectedQuantity = Number(event.target.value);
            if (!Number.isInteger(productStock) || productStock < 1) {
                return;
            }

            productQuantityEl.value = String(
                !Number.isInteger(selectedQuantity) || selectedQuantity < 1
                    ? 1
                    : Math.min(selectedQuantity, productStock)
            );
        });
    </script>
{% endblock %}
