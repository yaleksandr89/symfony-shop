{% set googleEnabled = oauth_provider_enabled('google') %}
{% set yandexEnabled = oauth_provider_enabled('yandex') %}
{% set vkontakteEnabled = oauth_provider_enabled('vkontakte') %}
{% set facebookEnabled = oauth_provider_enabled('facebook') %}
{% set githubRusEnabled = app.request.locale == 'ru' and oauth_provider_enabled('github_rus') %}
{% set githubEnEnabled = app.request.locale == 'en' and oauth_provider_enabled('github_en') %}
{% set hasEnabledProvider = googleEnabled or yandexEnabled or vkontakteEnabled or facebookEnabled or githubRusEnabled or githubEnEnabled %}

{% if hasEnabledProvider %}
    <div class="form-additional mt-2 pt-1">
        <div class="row">
        {% if googleEnabled %}
            <div class="col-sm-12 text-center">
                <a href="{{ path('connect_google_start') }}" class="btn btn-link btn-dark mb-1">
                    {{ 'login_social_network.google'|trans }}
                </a>
            </div>
        {% endif %}
        {% if yandexEnabled %}
            <div class="col-sm-12 text-center">
                <a href="{{ path('connect_yandex_start') }}" class="btn btn-link btn-dark mb-1">
                    {{ 'login_social_network.yandex'|trans }}
                </a>
            </div>
        {% endif %}
        {% if vkontakteEnabled %}
            <div class="col-sm-12 text-center">
                <a href="{{ path('connect_vkontakte_start') }}" class="btn btn-link btn-dark mb-1">
                    {{ 'login_social_network.vk'|trans }}
                </a>
            </div>
        {% endif %}
        {% if facebookEnabled %}
            <div class="col-sm-12 text-center">
                <a href="{{ path('connect_facebook_start') }}" class="btn btn-link btn-dark mb-1">
                    {{ 'login_social_network.facebook'|trans }}
                </a>
            </div>
        {% endif %}
        {% if githubRusEnabled %}
            <div class="col-sm-12 text-center">
                <a href="{{ path('connect_github_ru_start') }}" class="btn btn-link btn-dark mb-">
                    {{ 'login_social_network.github'|trans }}
                </a>
            </div>
        {% endif %}
        {% if githubEnEnabled %}
            <div class="col-sm-12 text-center">
                <a href="{{ path('connect_github_en_start') }}" class="btn btn-link btn-dark mb-">
                    {{ 'login_social_network.github'|trans }}
                </a>
            </div>
        {% endif %}
        </div>
    </div>
{% endif %}
