{% extends 'admin/layout/layout_main.html.twig' %}

{% block title_detailed %}{{ 'user.list.page_title'|trans({}, 'admin') }}{% endblock %}

{% block body %}
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            {% include 'admin/_embed/_card/_header_action.html.twig' with
                {
                    'sectionTitle': 'user.list.heading'|trans({}, 'admin'),
                    'actionUrl': path('admin_user_add')
                } %}
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="main_table">
                    <thead>
                    <tr>
                        <th>{{ 'user.list.column.id'|trans({}, 'admin') }}</th>
                        <th>{{ 'user.list.column.email'|trans({}, 'admin') }}</th>
                        <th>{{ 'user.list.column.role'|trans({}, 'admin') }}</th>
                        <th>{{ 'user.list.column.profile_info'|trans({}, 'admin') }}</th>
                        <th>{{ 'user.list.column.is_verified_email'|trans({}, 'admin') }}</th>
                        <th>{{ 'user.list.column.from_google'|trans({}, 'admin') }}</th>
                        <th>{{ 'user.list.column.from_yandex'|trans({}, 'admin') }}</th>
                        <th>{{ 'user.list.column.from_vk'|trans({}, 'admin') }}</th>
                        <th>{{ 'user.list.column.from_github'|trans({}, 'admin') }}</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user.id }}</td>
                            <td>{{ user.email }}</td>
                            <td>
                                {% if 'ROLE_SUPER_ADMIN' in user.roles %}
                                    <strong>{{ 'user.role.super_admin'|trans({}, 'admin') }}</strong>
                                {% elseif 'ROLE_ADMIN' in user.roles %}
                                    <strong>{{ 'user.role.admin'|trans({}, 'admin') }}</strong>
                                {% else %}
                                    {{ 'user.role.user'|trans({}, 'admin') }}
                                {% endif %}
                                <br>
                               <code><small>{{ user.roles|join(', ', ' and ') }}</small></code>
                            </td>
                            <td>
                                <code>{{ 'user.profile.full_name'|trans({}, 'admin') }}</code>: {{ user.fullName }}<br>
                                <code>{{ 'user.profile.phone'|trans({}, 'admin') }}</code>: {{ user.phone }}<br>
                                <code>{{ 'user.profile.address'|trans({}, 'admin') }}</code>: {{ user.address }}<br>
                                <code>{{ 'user.profile.zip_code'|trans({}, 'admin') }}</code>: {{ user.zipcode }}<br>
                            </td>
                            <td>
                                {% if user.isVerified %}
                                    <div class="alert alert-success">{{ 'user.state.verified'|trans({}, 'admin') }}</div>
                                {% else %}
                                    <div class="alert alert-warning">{{ 'user.state.not_verified'|trans({}, 'admin') }}</div>
                                {% endif %}
                            </td>
                            <td>
                                {% if user.googleId %}
                                    <div class="alert alert-success">{{ 'user.state.verified'|trans({}, 'admin') }}</div>
                                {% else %}
                                    <div class="alert alert-warning">{{ 'user.state.not_verified'|trans({}, 'admin') }}</div>
                                {% endif %}
                            </td>
                            <td>
                                {% if user.yandexId %}
                                    <div class="alert alert-success">{{ 'user.state.verified'|trans({}, 'admin') }}</div>
                                {% else %}
                                    <div class="alert alert-warning">{{ 'user.state.not_verified'|trans({}, 'admin') }}</div>
                                {% endif %}
                            </td>
                            <td>
                                {% if user.vkontakteId %}
                                    <div class="alert alert-success">{{ 'user.state.verified'|trans({}, 'admin') }}</div>
                                {% else %}
                                    <div class="alert alert-warning">{{ 'user.state.not_verified'|trans({}, 'admin') }}</div>
                                {% endif %}
                            </td>
                            <td>
                                {% if user.githubId %}
                                    <div class="alert alert-success">{{ 'user.state.verified'|trans({}, 'admin') }}</div>
                                {% else %}
                                    <div class="alert alert-warning">{{ 'user.state.not_verified'|trans({}, 'admin') }}</div>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-outline-info">{{ 'action.edit'|trans({}, 'admin') }}</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
