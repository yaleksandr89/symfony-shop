{% extends 'admin/layout/layout_main.html.twig' %}

{% block title_detailed %}{{ 'order.list.page_title'|trans({}, 'admin') }}{% endblock %}

{% block body %}
    {% include 'admin/order/_embed/_table_filtration.html.twig' with {
        'form': form
    } %}
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            {% include 'admin/_embed/_card/_header_action.html.twig' with
                {
                    'sectionTitle': 'order.list.heading'|trans({}, 'admin'),
                    'actionUrl': path('admin_order_add')
                } %}
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="main_table">
                    <thead>
                    <tr>
                        <th>{{ knp_pagination_sortable(pagination, 'order.list.column.id'|trans({}, 'admin'), 'o.id') }}</th>
                        <th>{{ knp_pagination_sortable(pagination, 'order.list.column.full_name'|trans({}, 'admin'), 'u.id') }}</th>
                        <th>{{ 'order.list.column.email'|trans({}, 'admin') }}</th>
                        <th>{{ 'order.list.column.phone'|trans({}, 'admin') }}</th>
                        <th>{{ knp_pagination_sortable(pagination, 'order.list.column.created_at'|trans({}, 'admin'), 'o.createdAt') }}</th>
                        <th>{{ 'order.list.column.product_count'|trans({}, 'admin') }}</th>
                        <th>{{ knp_pagination_sortable(pagination, 'order.list.column.total_price'|trans({}, 'admin'), 'o.totalPrice') }}</th>
                        <th>{{ knp_pagination_sortable(pagination, 'order.list.column.status'|trans({}, 'admin'), 'o.status') }}</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for order in pagination %}
                        <tr>
                            <td>{{ order.id }}</td>
                            <td>{{ order.owner.fullname|default('order.list.missing_full_name'|trans({}, 'admin')) }}</td>
                            <td>{{ order.owner.email }}</td>
                            <td>{{ order.owner.phone|default('order.list.missing_phone'|trans({}, 'admin')) }}</td>
                            <td>{{ order.createdAt|format_datetime('full', 'medium') }}</td>
                            <td>{{ order.getOrderProducts.getValues|length }}</td>
                            <td>{{ order.totalPrice|format_currency('USD') }}</td>
                            <td>{{ orderStatusChoice[order.status]|trans }}</td>
                            <td>
                                <a href="{{ path('admin_order_edit', {'id': order.id}) }}" class="btn btn-outline-info">{{ 'action.edit'|trans({}, 'admin') }}</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="navigation">
                {{ knp_pagination_render(pagination) }}
            </div>
        </div>
    </div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        const filterVisibilityBtnElement = document.getElementById('order_list_filters_btn');
        const filterVisibilityBlockElement = document.getElementById('order_list_filters_block');
        const filterSection = 'order_list';

        document.addEventListener('DOMContentLoaded', () => {
            filterVisibilityBtnElement.addEventListener('click', () =>{
                 toggleFiltersVisibility(filterSection);
                 changeFiltersBlockView(filterSection, filterVisibilityBlockElement);
            });
            changeFiltersBlockView(filterSection, filterVisibilityBlockElement);
        });
    </script>
{% endblock %}
