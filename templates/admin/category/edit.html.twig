{% extends 'admin/layout/layout_main.html.twig' %}

{% block title_detailed %}{{ 'category.edit.page_title'|trans({}, 'admin') }}{% endblock %}

{% block body %}
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            {% include 'admin/_embed/_card/_breadcrumbs.html.twig' with {
                'sectionTitle': 'navigation.categories'|trans({}, 'admin'),
                'entity': category,
                'actionUrl': path('admin_category_list'),
                'addActionUrl': path('admin_category_add'),
                'editLabel': 'action.edit'|trans({}, 'admin'),
                'addLabel': 'action.add_new'|trans({}, 'admin'),
                'addButtonLabel': 'action.add_new'|trans({}, 'admin'),
            } %}
        </div>
        <div class="card-body">
            {{ form_start(form) }}
            <div class="form-group row">
                <div class="col-md-1">
                    {{ form_label(form.title) }}
                </div>
                <div class="col-md-11">
                    {{ form_widget(form.title) }}
                    <div class="form-error">
                        {{ form_errors(form.title) }}
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-1">
                    {{ 'category.form.field.slug'|trans({}, 'admin') }}
                </div>
                <div class="col-md-11">
                    {% if category %}
                        {{ category.slug }}
                    {% endif %}
                </div>
            </div>

            <hr/>

            {% include 'admin/_embed/_card/_form_buttons.html.twig' with {
                'entity':category,
                'catalogUrl':path('admin_category_list'),
                'submitBtn':form_widget(form.submit, {'attr': {'class': 'btn btn-primary'}}),
                'deleteLabel': 'modal.delete_row'|trans({}, 'admin'),
            } %}

            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>

    {% if category and category.id %}
        {% include 'admin/_embed/_utils/_modal.html.twig' with {
            'modalId': 'approveDeleteModal',
            'modalTitle': 'modal.confirm_delete'|trans({}, 'admin'),
            'modalText': 'category.modal.delete_text'|trans({}, 'admin'),
            'modalBtnText': 'modal.delete_row'|trans({}, 'admin'),
            'actionUrl': path('admin_category_delete', {'id': category.id}),
            'cancelLabel': 'modal.cancel'|trans({}, 'admin'),
            'closeLabel': 'modal.close'|trans({}, 'admin'),
        } %}
    {% endif %}

{% endblock %}
