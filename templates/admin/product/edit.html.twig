{% extends 'admin/layout/layout_main.html.twig' %}

{% block title_detailed %}{{ 'product.edit.page_title'|trans({}, 'admin') }}{% endblock %}

{% block body %}
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            {% include 'admin/_embed/_card/_breadcrumbs.html.twig' with {
                'sectionTitle': 'navigation.products'|trans({}, 'admin'),
                'entity': product,
                'actionUrl': path('admin_product_list'),
                'addActionUrl': path('admin_product_add'),
                'editLabel': 'action.edit'|trans({}, 'admin'),
                'addLabel': 'action.add_new'|trans({}, 'admin'),
                'addButtonLabel': 'action.add_new'|trans({}, 'admin'),
            } %}
        </div>
        <div class="card-body">
            {{ form_start(form) }}
            <div class="form-group row">
                <div class="col-md-1">
                    {{ form_label(form.title) }}
                </div>
                <div class="col-md-11">
                    {{ form_widget(form.title) }}
                    <div class="form-error">
                        {{ form_errors(form.title) }}
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-1">
                    {{ 'product.form.slug'|trans({}, 'admin') }}
                </div>
                <div class="col-md-11">
                    {% if product %}
                        {{ product.slug }}
                    {% endif %}
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-1">
                    {{ form_label(form.price) }}
                </div>
                <div class="col-md-11">
                    {{ form_widget(form.price) }}
                    <div class="form-error">
                        {{ form_errors(form.price) }}
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-1">
                    {{ form_label(form.quantity) }}
                </div>
                <div class="col-md-11">
                    {{ form_widget(form.quantity) }}
                    <div class="form-error">
                        {{ form_errors(form.quantity) }}
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-1">
                    {{ form_label(form.description) }}
                </div>
                <div class="col-md-11">
                    {{ form_widget(form.description) }}
                    <div class="form-error">
                        {{ form_errors(form.description) }}
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-1">
                    {{ form_label(form.category) }}
                </div>
                <div class="col-md-11">
                    {{ form_widget(form.category) }}
                    <div class="form-error">
                        {{ form_errors(form.category) }}
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-1">
                    {{ form_label(form.newImage) }}
                </div>
                <div class="col-md-11">
                    {{ form_widget(form.newImage) }}
                    <div class="form-error">
                        {{ form_errors(form.newImage) }}
                    </div>
                </div>
            </div>

            {% if images|length %}
                <div class="row">
                    <div class="col-md-12">
                        <span class="text-gray-600">{{ 'product.image.current'|trans({}, 'admin') }}:</span>
                    </div>
                </div>

                {% for image in images %}
                    <div class="row mt-2">
                        <div class="col-md-5">
                            <img src="{{ asset('uploads/images/products/' ~ product.id ~ '/' ~ image.filenameMiddle) }}" alt="{{ image.filenameMiddle }}">
                        </div>
                        <div class="col-md-7">
                            <a href="{{ path('admin_product_image_delete', {'id': image.id}) }}" class="btn btn-outline-info">
                                {{ 'product.image.delete'|trans({}, 'admin') }}
                            </a>
                        </div>
                    </div>
                {% endfor %}

            {% endif %}

            <div class="form-group row">
                <div class="col-md-1"></div>
                <div class="col-md-11 pl-5">
                    {{ form_widget(form.isPublished) }}
                    {{ form_label(form.isPublished) }}
                    <div class="form-error">
                        {{ form_errors(form.isPublished) }}
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-1"></div>
                <div class="col-md-11 pl-5">
                    {{ form_widget(form.isNew) }}
                    {{ form_label(form.isNew) }}
                    <div class="form-error">
                        {{ form_errors(form.isNew) }}
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-1"></div>
                <div class="col-md-11 pl-5">
                    {{ form_widget(form.isOnSale) }}
                    {{ form_label(form.isOnSale) }}
                    <div class="form-error">
                        {{ form_errors(form.isOnSale) }}
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-md-1"></div>
                <div class="col-md-11 pl-5">
                    {{ form_widget(form.isDeleted) }}
                    {{ form_label(form.isDeleted) }}
                    <div class="form-error">
                        {{ form_errors(form.isDeleted) }}
                    </div>
                </div>
            </div>

            <hr/>

            {% include 'admin/_embed/_card/_form_buttons.html.twig' with {
                'entity':product,
                'catalogUrl':path('admin_product_list'),
                'submitBtn':form_widget(form.submit, {'attr': {'class': 'btn btn-primary'}}),
                'deleteLabel': 'modal.delete_row'|trans({}, 'admin'),
            } %}

            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
    {% if product and product.id %}
        {% include 'admin/_embed/_utils/_modal.html.twig' with {
            'modalId': 'approveDeleteModal',
            'modalTitle': 'modal.confirm_delete'|trans({}, 'admin'),
            'modalText': 'product.modal.delete_text'|trans({}, 'admin'),
            'modalBtnText': 'modal.delete_row'|trans({}, 'admin'),
            'actionUrl': path('admin_product_delete', {'id': product.id}),
            'cancelLabel': 'modal.cancel'|trans({}, 'admin'),
            'closeLabel': 'modal.close'|trans({}, 'admin'),
        } %}
    {% endif %}
{% endblock %}
