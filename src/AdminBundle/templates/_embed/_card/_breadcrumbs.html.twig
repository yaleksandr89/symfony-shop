<div class="d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center">
        <a href="{{ actionUrl }}" class="font-weight-bold text-primary">{{ sectionTitle }}</a>
        <div class="ml-2 mr-2">/</div>
        <h6 class="m-0 font-weight-bold text-primary">
            {% if entity and entity.id %}
                {{ entity.title|default(editLabel|default('action.edit'|trans({}, 'admin'))) }}
            {% else %}
                {{ addLabel|default('action.add_new'|trans({}, 'admin')) }}
            {% endif %}
        </h6>
    </div>
    <a href="{{ addActionUrl }}" class="d-none d-sm-inline-block btn btn-sm btn-info shadow-sm">
        <i class="fas fa-plus fa-sm text-white-50"></i> {{ addButtonLabel|default('action.add_new'|trans({}, 'admin')) }}
    </a>
</div>
