# Локальная инфраструктура Docker Compose и параметры подключения браузерных тестов.
# Файл создаётся командой `make init`; настройки приложения находятся в .env.

### Права файлов на хосте ###
HOST_UID=1000
HOST_GID=1000

### Docker Compose ###
APP_PORT=8080

### PostgreSQL ###
POSTGRES_DB=s_shop
POSTGRES_USER=s_shop
POSTGRES_PASSWORD=s_shop

### Браузерные тесты ###
PANTHER_WEB_SERVER_HOST=php
PANTHER_WEB_SERVER_PORT=9080
