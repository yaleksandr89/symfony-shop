HOST_UID=1000
HOST_GID=1000
APP_PORT=8080

PHP_IDE_CONFIG=serverName=symfony-shop

POSTGRES_DB=s_shop
POSTGRES_USER=s_shop
POSTGRES_PASSWORD=s_shop

DATABASE_URL=postgresql://s_shop:s_shop@postgres:5432/s_shop?serverVersion=18&charset=utf8
APP_ENV=dev
APP_SECRET=local-docker-dev-secret-change-me
SITE_BASE_SCHEME=http
SITE_BASE_HOST=localhost:8080
ADMIN_EMAIL=admin@example.test
MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=doctrine://default
APP_TIMEZONE=Europe/Moscow
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$
SELENIUM_SERVER_URL=http://selenium:4444/wd/hub
PANTHER_WEB_SERVER_HOST=php
PANTHER_WEB_SERVER_PORT=9080

OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=
OAUTH_VK_CLIENT_ID=
OAUTH_VK_CLIENT_SECRET=
OAUTH_GITHUB_EN_CLIENT_ID=
OAUTH_GITHUB_EN_CLIENT_SECRET=
OAUTH_GITHUB_RUS_CLIENT_ID=
OAUTH_GITHUB_RUS_CLIENT_SECRET=
